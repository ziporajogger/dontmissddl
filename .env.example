# ==========================================
# dontmissddl — Environment Variables
# ==========================================
# Copy this file to .env (for local testing)
# For production, set these as GitHub Secrets

# --- LLM API (required) ---
# DeepSeek is cheap and good for Chinese (~$0.001 per extraction)
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- Feishu app (reads group messages + writes Bitable) ---
# Create an app at https://open.feishu.cn
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated chat_ids of groups to monitor
FEISHU_GROUP_IDS=oc_xxxxxxxx,oc_yyyyyyyy

# --- Feishu Bitable (storage) ---
# 留空即可：setup.py 会自动创建多维表格和字段，并把 token 写回这里。
# 如果你已有表格，手动填下面两个；否则保持注释状态，交给 setup.py。
# FEISHU_APP_TOKEN=bascnxxxxxxxxxxxxxxxx   # 多维表格 app_token（链接 /base/ 后那串）
# FEISHU_TABLE_ID=tblxxxxxxxxxxxxxxxx      # 数据表 table_id
# 选填（自动建表时用）：
# FEISHU_BITABLE_NAME=DDL 提醒表
# FEISHU_FOLDER_TOKEN=

# --- Email (IMAP) (optional) ---
# 支持所有 IMAP 邮箱，常用服务商填法：
#   QQ 邮箱    host=imap.qq.com            port=993  密码填「授权码」
#   163 邮箱   host=imap.163.com           port=993  密码填「授权码」
#   126 邮箱   host=imap.126.com           port=993  密码填「授权码」
#   Gmail      host=imap.gmail.com         port=993  密码填「应用专用密码」(App Password)
#   Outlook    host=outlook.office365.com  port=993  密码填「应用密码」
# EMAIL_HOST=imap.qq.com
# EMAIL_PORT=993
# EMAIL_USER=your-email@qq.com
# EMAIL_PASSWORD=your-imap-auth-code

# --- WeChat public accounts (optional) ---
# Comma-separated account names to watch (e.g. 字节跳动招聘,腾讯招聘)
# WECHAT_SOGOU_NAMES=字节跳动招聘,腾讯招聘

# NOTE: reminders are handled by Feishu Bitable automation, not by this code.
