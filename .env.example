# ==========================================
# dontmissddl — Environment Variables
# ==========================================
# Copy this file to .env (for local testing)
# For production, set these as GitHub Secrets

# --- LLM API (required) ---
# 支持任意 OpenAI 兼容的大模型；换厂商改下面 LLM_BASE_URL / LLM_MODEL 即可
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- Feishu app (reads group messages + writes Bitable) ---
# Create an app at https://open.feishu.cn
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated chat_ids of groups to monitor
FEISHU_GROUP_IDS=oc_xxxxxxxx,oc_yyyyyyyy

# --- Feishu Bitable (storage) ---
# 留空即可：setup.py 会自动创建多维表格和字段，并把 token 写回这里。
# 如果你已有表格，手动填下面两个；否则保持注释状态，交给 setup.py。
# FEISHU_APP_TOKEN=bascnxxxxxxxxxxxxxxxx   # 多维表格 app_token（链接 /base/ 后那串）
# FEISHU_TABLE_ID=tblxxxxxxxxxxxxxxxx      # 数据表 table_id
# 选填（自动建表时用）：
# FEISHU_BITABLE_NAME=DDL 提醒表
# FEISHU_FOLDER_TOKEN=

# --- Google Calendar (storage, alternative to Bitable) (optional) ---
# 用服务账号（零服务器）：在 Google Cloud 建服务账号、下载 JSON key，把整个
# JSON 内容贴到 GOOGLE_SERVICE_ACCOUNT；再把日历分享给服务账号邮箱。
# 配了这两个就用 Google Calendar 存 DDL，否则用上面的飞书多维表格。
# GOOGLE_CALENDAR_ID=xxxxxxxxxxxxxxxx@group.calendar.google.com
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# --- Email (IMAP) (optional) ---
# 支持所有 IMAP 邮箱，常用服务商填法：
#   QQ 邮箱    host=imap.qq.com            port=993  密码填「授权码」
#   163 邮箱   host=imap.163.com           port=993  密码填「授权码」
#   126 邮箱   host=imap.126.com           port=993  密码填「授权码」
#   Gmail      host=imap.gmail.com         port=993  密码填「应用专用密码」(App Password)
#   Outlook    host=outlook.office365.com  port=993  密码填「应用密码」
# EMAIL_HOST=imap.qq.com
# EMAIL_PORT=993
# EMAIL_USER=your-email@qq.com
# EMAIL_PASSWORD=your-imap-auth-code

# --- WeChat public accounts (optional) ---
# Comma-separated account names to watch (e.g. 字节跳动招聘,腾讯招聘)
# WECHAT_SOGOU_NAMES=字节跳动招聘,腾讯招聘

# --- 通知渠道（可选，代码发；不配就用飞书自动化提醒）---
# 填了哪个就用哪个发「新增 DDL」和「7/3/1 天到期」通知，可多个同时。
# NOTIFY_FEISHU_CHAT_ID=oc_xxxxxxxx      # 飞书群 chat_id（发提醒的群）
# TELEGRAM_BOT_TOKEN=123456:ABC...       # Telegram BotFather 拿的 token
# TELEGRAM_CHAT_ID=123456789             # 接收消息的 chat_id
# NTFY_TOPIC=my-topic                    # ntfy.sh 的 topic（手机装 ntfy 订阅）
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=...
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
# NOTIFY_EMAIL_HOST=smtp.qq.com          # 发通知用的 SMTP（区别于上面的 IMAP 收邮件）
# NOTIFY_EMAIL_PORT=465
# NOTIFY_EMAIL_USER=your-email@qq.com
# NOTIFY_EMAIL_PASSWORD=your-smtp-auth-code
# NOTIFY_EMAIL_TO=receive@qq.com         # 收件人，默认发给自己

# NOTE: 提醒默认由飞书多维表格自动化负责；上面的 NOTIFY_* 是可选的代码发通知。
