# ==========================================
# dontmissddl — Environment Variables
# ==========================================
# Copy this file to .env (for local testing)
# For production, set these as GitHub Secrets

# --- Feishu Bot (optional if using email/RSS) ---
# Create an app at https://open.feishu.cn
# Enable Bot capability, add im:message permission
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated chat_ids of groups to monitor
FEISHU_GROUP_IDS=oc_xxxxxxxx,oc_yyyyyyyy

# --- Email (IMAP) (optional) ---
# QQ Mail: host=imap.qq.com, port=993
# 163 Mail: host=imap.163.com, port=993
# Gmail: host=imap.gmail.com, port=993 (need app password)
# EMAIL_HOST=imap.qq.com
# EMAIL_PORT=993
# EMAIL_USER=your-email@qq.com
# EMAIL_PASSWORD=your-imap-auth-code

# --- WeChat RSS (optional) ---
# Comma-separated RSS feed URLs from Feeddd/WeRSS
# Example: https://feeddd.org/feeds/xxx
# WECHAT_RSS_URLS=https://feeddd.org/feeds/xxx,https://feeddd.org/feeds/yyy

# --- LLM API (required) ---
# DeepSeek is cheap and good for Chinese (~$0.001 per extraction)
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- Reminder Settings ---
REMINDER_DAYS=7,3,1
TZ=Asia/Shanghai
